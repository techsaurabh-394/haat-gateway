# Copy to .env (never commit it). `npm run ondc:keygen` writes a filled-in version to .ondc/haat.env.
HAAT_NETWORK=mock            # mock | ondc
HAAT_PORT=8080
HAAT_HOST=127.0.0.1          # 0.0.0.0 in containers
HAAT_DB=./haat.db            # SQLite file; omit for in-memory (lost on restart)
# HAAT_TLS_KEY=/path/key.pem # serve HTTPS directly (or terminate TLS at a proxy)
# HAAT_TLS_CERT=/path/cert.pem

# --- only for HAAT_NETWORK=ondc ---
HAAT_ONDC_ENV=preprod        # preprod | prod  (staging is decommissioned by ONDC)
HAAT_PUBLIC_URL=https://your.domain.in
HAAT_ORG_NAME=Your organisation
HAAT_CITY=std:0542
HAAT_SIGN_IN=off             # on needs a real OTP provider wired in src/main.ts
ONDC_SUBSCRIBER_ID=your.domain.in
ONDC_UNIQUE_KEY_ID=
ONDC_SIGNING_PUBLIC_KEY=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=
ONDC_REQUEST_ID=
ONDC_CALLBACK_PATH=/ondc
ONDC_GATEWAY_URL=
